        {
          "_name": "content8",
          "_sourceTheme": "mobirise5",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "background-color": "@bgColor",
            ".counter-container": {
              "ul": {
                "margin": "0",
                "list-style": "none",
                "padding-left": "2.5rem",
                "li": {
                  "margin-bottom": "1rem",
                  "position": "relative",
                  "& when (@stylizedCounters)": {
                    "list-style": "none",
                    "position": "relative",
                    "padding-left": "1rem",
                    "&:before": {
                      "position": "absolute",
                      "left": "-40px",
                      "content": "\"\"",
                      "display": "flex",
                      "justify-content": "center",
                      "align-items": "center",
                      "color": "contrast(@iconColor)",
                      "background-color": "@iconColor",
                      "width": "40px",
                      "height": "40px",
                      "border-radius": "50%",
                      "margin-top": "5px",
                      "& when (@countersType = \"circle\")": {
                        "background": "none",
                        "border": "1px solid @iconColor",
                        "color": "@iconColor"
                      },
                      "& when (@countersType = \"square\")": {
                        "border-radius": "0"
                      },
                      "& when (@mark)": {
                        "content": "\"✓\""
                      }
                    }
                  },
                  "& when not (@stylizedCounters)": {
                    "&:before": {
                      "position": "absolute",
                      "left": "-1.6rem",
                      "content": "\"\\2022\"",
                      "color": "@iconColor",
                      "font-weight": "bold",
                      "font-size": "2rem",
                      "width": "1.6rem",
                      "line-height": "1.2"
                    }
                  }
                }
              }
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"content8\" group=\"Content\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"3\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"3\">\n        <input type=\"range\" name=\"textWidth\" title=\"Width\" min=\"4\" max=\"12\" value=\"11\" step=\"1\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Stylized\" name=\"stylizedCounters\" checked>\n        <input type=\"checkbox\" title=\"Mark\" name=\"mark\" checked condition=\"stylizedCounters\">\n        <select title=\"Type\" name=\"countersType\" condition=\"stylizedCounters\">\n            <option value=\"default\" selected>Сircle Fill</option>\n            <option value=\"circle\">Circle</option>\n            <option value=\"square\">Square</option>\n        </select>\n        <input type=\"color\" name=\"iconColor\" title=\"Color\" value=\"#393193\">\n        <header>Background</header>\n        <input type=\"color\" title=\"Color\" name=\"bgColor\" value=\"#f7f7f7\">\n    </mbr-parameters>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"counter-container col-md-12 col-lg-{{textWidth}}\">\n                <h4 class=\"mbr-section-title mbr-fonts-style mb-4\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-7\"><div><b>Audifort™</b> is marketed as a hearing-support supplement containing a blend of nutrients and botanical ingredients selected to support overall auditory wellness. The formula is designed to complement the body's natural processes and provide nutritional support as part of a healthy daily routine.</div></h4>\n                <div class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\" data-multiline mbr-article>\n                    <ul>\n                        <li><span style=\"font-size: 20.8px;\"><b>Ginkgo Biloba Extract – </b>Traditionally used to support healthy circulation and antioxidant protection, making it a popular botanical in wellness formulas.</span></li><li><b style=\"font-size: 20.8px;\">Garlic Extract – </b><span style=\"font-size: 20.8px;\">Provides naturally occurring plant compounds that are commonly associated with cardiovascular health, healthy circulation, and antioxidant support.</span></li><li><span style=\"font-size: 20.8px;\"><b>Vitamin B12 – </b>An essential nutrient that supports normal nerve function, red blood cell formation, and healthy cellular metabolism.</span></li><li><span style=\"font-size: 20.8px;\"><b>Vitamin B6 – </b>Helps support normal nervous-system function, energy metabolism, and the body's natural processing of proteins and nutrients.</span></li><li><span style=\"font-size: 20.8px;\"><b>Zinc – </b>An essential mineral that contributes to normal immune function, cellular health, and protection from oxidative stress.</span></li><li><span style=\"font-size: 20.8px;\"><b>Magnesium – </b>Supports normal nerve and muscle function and contributes to healthy energy production and overall cellular wellness.</span></li><li><span style=\"font-size: 20.8px;\"><b>Vitamin C – </b>A powerful nutritional antioxidant that helps protect cells from oxidative stress and supports normal immune function.</span></li><li><span style=\"font-size: 20.8px;\"><b>Folate – </b>An important B vitamin that contributes to normal cell division and healthy cellular function.</span></li><li><span style=\"font-size: 20.8px;\"><b>Antioxidant Nutrients –</b> The formula is designed to provide nutritional compounds that support the body's natural antioxidant defenses and overall cellular wellness.</span></li><li><span style=\"font-size: 20.8px;\"><b>Daily Wellness Support –</b> Together, the formula's nutrients and botanical ingredients are intended to complement a healthy lifestyle and provide ongoing nutritional support for general auditory and nervous-system wellness.</span></li>\n                    </ul>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
